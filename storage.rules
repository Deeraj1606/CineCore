rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAppropriateSize() {
      return request.resource.size < 15 * 1024 * 1024; // 15MB max for free-tier safety
    }

    function isAllowedMimeType() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('text/.*') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType == 'application/json';
    }

    // Project-specific storage assets (moodboard images, script PDFs, exports)
    match /projects/{projectId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAppropriateSize() && isAllowedMimeType();
      allow delete: if isAuthenticated();
    }

    // User profile avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId && isAppropriateSize() && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
